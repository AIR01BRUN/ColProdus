<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="flex-grow: 1; width: 100%; height: 100%; flex-shrink: 0; flex-basis: auto;">
        <ui:VisualElement name="SCENE" style="flex-grow: 0; position: absolute;"/>
        <ui:VisualElement name="NOTIF" style="width: auto; height: auto; aspect-ratio: auto;"/>
        <ui:VisualElement name="UI" style="width: 100%; height: 100%; aspect-ratio: auto; align-items: center; justify-content: center; flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
