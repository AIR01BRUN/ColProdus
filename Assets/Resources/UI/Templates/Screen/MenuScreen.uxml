<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Menu modal commun (TilteScreen, NewGameScreen, PauseScreen, LoadSaveScreenScreen) -->
    <ui:VisualElement name="ROOT" style="flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; height: 100%; align-self: auto; align-items: center; justify-content: center; background-color: rgba(28, 38, 51, 0.72); align-content: auto; position: relative; overflow: hidden;">
        <ui:VisualElement name="Menu" style="flex-grow: 0; flex-shrink: 1; min-height: 0; width: 60%; max-width: 90%; height: 60%; max-height: 80%; justify-content: center; align-items: center; overflow: hidden;"/>
    </ui:VisualElement>
</ui:UXML>
