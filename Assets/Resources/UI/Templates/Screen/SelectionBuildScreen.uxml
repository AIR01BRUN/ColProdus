<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="flex-grow: 1; flex-direction: column; background-color: rgb(35, 35, 35); width: 100%; height: 100%;">
        <ui:VisualElement name="Header" style="flex-grow: 0; flex-direction: column; width: 100%; flex-shrink: 0; background-color: rgb(45, 45, 45); border-bottom-width: 2px; border-bottom-color: rgb(162, 125, 101); padding-bottom: 6px;">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; width: 100%; height: 40px; align-items: center; padding-left: 12px; padding-right: 12px;">
                <ui:Label name="TitleLabel" text="CONSTRUCTION" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-left;"/>
            </ui:VisualElement>
            <ui:VisualElement name="TabBar" style="flex-grow: 0; flex-direction: row; width: 100%; height: 32px; align-items: center; padding-left: 12px; padding-right: 12px;">
                <ui:Button name="TabZone" text="ZONE" style="flex-grow: 0; height: 28px; min-width: 90px; margin-right: 6px; font-size: 13px; -unity-font-style: bold; color: rgb(255, 255, 255); background-color: rgb(162, 125, 101); border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-left-color: rgb(203, 174, 156); border-right-color: rgb(203, 174, 156); border-top-color: rgb(203, 174, 156); border-bottom-color: rgb(203, 174, 156);"/>
                <ui:Button name="TabDeco" text="DECO" style="flex-grow: 0; height: 28px; min-width: 90px; margin-right: 6px; font-size: 13px; -unity-font-style: bold; color: rgb(255, 255, 255); background-color: rgb(74, 74, 74); border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-left-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-top-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187);"/>
                <ui:Button name="TabStock" text="ZONE STOCK" style="flex-grow: 0; height: 28px; min-width: 110px; margin-right: 6px; font-size: 13px; -unity-font-style: bold; color: rgb(255, 255, 255); background-color: rgb(74, 74, 74); border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-left-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-top-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="ContentBase" style="flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; height: 100%; background-color: rgb(27, 27, 27); padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; align-content: flex-start;">
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>