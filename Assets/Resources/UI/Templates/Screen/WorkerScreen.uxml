<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="flex-grow: 1; flex-direction: row; width: 100%; height: 100%; background-color: rgb(35, 35, 35);">
        <ui:VisualElement name="LeftColumn" style="width: 260px; min-width: 220px; flex-shrink: 0; flex-direction: column; background-color: rgb(28, 28, 28); border-right-width: 1px; border-right-color: rgb(70, 70, 70);">
            <ui:VisualElement name="TopBar" style="height: 52px; flex-direction: row; align-items: center; padding-left: 10px; padding-right: 10px; border-bottom-width: 1px; border-bottom-color: rgb(70, 70, 70);"/>
            <ui:ScrollView name="LeftScroll" style="flex-grow: 1;">
                <ui:VisualElement name="LeftPanel" style="flex-grow: 1; flex-direction: column; padding: 10px; gap: 8px;"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="RightColumn" style="flex-grow: 1; flex-direction: column; background-color: rgb(40, 40, 40);">
            <ui:VisualElement name="RightHeader" style="height: 52px; border-bottom-width: 1px; border-bottom-color: rgb(70, 70, 70); justify-content: center; padding-left: 16px;">
                <ui:Label text="Preview" style="unity-font-style: bold; font-size: 16px; color: rgb(235, 235, 235);"/>
            </ui:VisualElement>
            <ui:ScrollView name="RightScroll" style="flex-grow: 1;">
                <ui:VisualElement name="RightPanel" style="flex-grow: 1; padding: 12px;"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
