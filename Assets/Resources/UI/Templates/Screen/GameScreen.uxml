<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="flex-grow: 1; width: 100%; height: 100%; align-self: auto; align-items: center; justify-content: flex-start; background-color: rgba(28, 38, 51, 0.72); align-content: auto; position: relative;">
        <ui:VisualElement name="TimeContent" style="flex-grow: 0; flex-shrink: 0; width: 100%;"/>
        <ui:VisualElement name="AllItemContent" style="flex-grow: 0; flex-shrink: 1; width: 100%; align-items: flex-end; padding-right: 6px; padding-top: 4px;"/>
        <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; flex-direction: column-reverse; justify-content: flex-start;">
            <ui:VisualElement name="SelecedtContent" style="flex-grow: 0; flex-shrink: 1; width: 100%; max-height: 45%; flex-direction: column; justify-content: flex-end; min-height: 0; overflow: hidden;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Menu" style="flex-grow: 0; width: 100%; height: 50px; flex-direction: row; justify-content: center; align-items: auto; max-height: 50px;"/>
    </ui:VisualElement>
</ui:UXML>
