<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!--
        Formulaire modal (NEW GAME, LOAD / SAVE) : contenu à gauche, boutons en bas.
        La zone de contenu est scrollable et plafonnée pour que la liste des sauvegardes
        ne pousse pas les boutons hors de l'écran.
    -->
    <ui:VisualElement name="ROOT" style="flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; height: 100%; align-self: auto; align-items: center; justify-content: center; background-color: rgba(28, 38, 51, 0); align-content: auto; position: relative; overflow: hidden;">
        <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; justify-content: center; flex-direction: row; height: auto; max-height: 100%;">
            <ui:ScrollView name="ContentScroll" mode="Vertical" style="flex-grow: 1; flex-shrink: 1; min-height: 0; width: auto; max-height: 100%; padding-right: 4px;">
                <ui:VisualElement name="Content" style="flex-grow: 0; flex-shrink: 1; width: 100%;"/>
            </ui:ScrollView>
            <ui:VisualElement style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; width: 100%;">
            <ui:VisualElement name="CancelBtnPlacement" style="flex-grow: 1; flex-shrink: 1; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; justify-content: center; align-items: center;"/>
            <ui:VisualElement name="ValideBtnPlacement" style="flex-grow: 1; flex-shrink: 1; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; align-items: center; justify-content: center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
