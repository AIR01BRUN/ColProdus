<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="flex-grow: 0; flex-direction: row; width: 100%; height: 600px; background-color: rgba(0, 0, 0, 0);">
        <!-- aperçu de l'objet (gauche) -->
        <ui:VisualElement name="Background" style="flex-grow: 0; position: absolute; left: 0; top: 0; width: 50%; height: 100%; align-items: center; justify-content: center; padding-top: 4; padding-right: 4; padding-bottom: 4; padding-left: 4;">
            <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(28, 38, 51); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
        </ui:VisualElement>

        <!-- zone gauche : onglets + contenu du template sélectionné -->
        <ui:VisualElement style="flex-grow: 1; height: 100%; width: 50%;">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: center; width: 100%; height: 40px; padding-left: 4; padding-right: 4;">
                <ui:VisualElement style="flex-grow: 0; width: 20px; height: 20px; flex-shrink: 0; background-color: rgb(67, 96, 123); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; align-self: center; margin-right: 6;"/>
                <ui:VisualElement name="ButtonScollView" style="flex-grow: 1; flex-shrink: 1; flex-direction: row; align-items: center; justify-content: flex-start; align-self: center; height: 34px; min-width: 100px; background-color: rgb(43, 60, 79); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; padding-top: 4; padding-right: 6; padding-bottom: 4; padding-left: 6; margin-top: 0; margin-right: 6; margin-bottom: 0; margin-left: 6;">
                    <ui:VisualElement name="TiltePlacement" style="flex-grow: 0; height: 100%; align-self: center; justify-content: center;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; width: 20px; height: 20px; flex-shrink: 0; background-color: rgb(67, 96, 123); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; align-self: center; margin-left: 6;"/>
            </ui:VisualElement>

            <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 1; padding-left: 4; padding-right: 4; padding-top: 4;">
                <ui:VisualElement style="flex-grow: 0; width: 4px; align-self: stretch; background-color: rgb(67, 96, 123); border-top-left-radius: 2px; border-bottom-left-radius: 2px; margin-left: 2; margin-right: 2;"/>
                <ui:ScrollView name="Content" mode="Vertical" style="flex-grow: 1; flex-shrink: 1; background-color: rgba(0, 0, 0, 0); padding-top: 2; padding-right: 4; padding-bottom: 6; padding-left: 4;"/>
                <ui:VisualElement style="flex-grow: 0; width: 4px; align-self: stretch; background-color: rgb(67, 96, 123); border-top-right-radius: 2px; border-bottom-right-radius: 2px; margin-left: 2; margin-right: 2;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- zone droite : actions + panneaux (selection, build...) -->
        <ui:VisualElement name="ActionContent" style="flex-grow: 1; height: 100%; width: 50%; background-color: rgb(28, 38, 51); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(67, 96, 123); border-right-color: rgb(67, 96, 123); border-bottom-color: rgb(67, 96, 123); border-left-color: rgb(67, 96, 123); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-top: 4; margin-right: 4; margin-bottom: 4; margin-left: 4; padding-top: 4; padding-right: 4; padding-bottom: 4; padding-left: 4;"/>
    </ui:VisualElement>
</ui:UXML>
