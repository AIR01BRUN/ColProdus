<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="flex-grow: 0; width: auto; height: auto; align-self: auto; align-items: flex-start; justify-content: flex-start; background-color: rgba(28, 38, 51, 0.72); align-content: auto; position: relative; flex-shrink: 0; flex-direction: row;">
        <ui:VisualElement name="CaseContent" style="flex-grow: 0;"/>
        <ui:VisualElement name="InfoContent" style="flex-grow: 0; align-items: flex-start; padding-top: 5px; padding-left: 5px; padding-right: 5px; padding-bottom: 5px;"/>
    </ui:VisualElement>
</ui:UXML>
