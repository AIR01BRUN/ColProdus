<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Champ texte : libellé à gauche, saisie à droite -->
    <Style src="project://database/Assets/Resources/UI/Templates/Prefab/Field_0.uss?fileID=7433441132597879392&amp;guid=38e5d7c94278be24abdec074b6e9eeba&amp;type=3#Field_0"/>
    <ui:VisualElement name="ROOT" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: center; min-width: 180px; min-height: 28px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; background-color: rgb(67, 96, 123); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
        <ui:Label text="text" name="Text" enable-rich-text="false" style="flex-grow: 0; width: 78px; height: 100%; color: rgb(203, 174, 156); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; height: 22px; background-color: rgb(159, 178, 196); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;">
            <ui:TextField value="" name="Value" class="Value" style="flex-grow: 1; width: auto; height: 100%; color: rgb(255, 255, 255); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-left;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
