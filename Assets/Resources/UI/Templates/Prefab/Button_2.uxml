<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Grand bouton (écrans de jeu : PAUSE, SPEED, BUILD, ...) -->
    <ui:VisualElement name="ROOT" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: center; min-width: 120px; min-height: 40px;">
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 26px; height: 40px; background-color: rgb(67, 96, 123); border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 10px; border-bottom-left-radius: 10px;"/>
        <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; flex-direction: row; align-items: center; justify-content: center; height: 40px; padding-top: 6px; padding-right: 10px; padding-bottom: 6px; padding-left: 10px; background-color: rgb(67, 96, 123); border-top-width: 1px; border-bottom-width: 1px; border-top-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187);">
            <ui:Label text="Button" enable-rich-text="false" name="Text" style="flex-grow: 1; width: 100%; height: auto; color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 26px; height: 40px; background-color: rgb(67, 96, 123); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-top-right-radius: 10px; border-bottom-right-radius: 10px;"/>
        <ui:VisualElement name="Active" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(255, 255, 255, 0.15); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(255, 242, 76); border-right-color: rgb(255, 242, 76); border-bottom-color: rgb(255, 242, 76); border-left-color: rgb(255, 242, 76); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; display: flex;"/>
        <ui:Button name="Button" text="&#10;" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; height: auto; min-width: auto; min-height: auto; max-width: none; max-height: none; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: initial;"/>
    </ui:VisualElement>
</ui:UXML>
