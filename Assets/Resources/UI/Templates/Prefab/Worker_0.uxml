<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="align-self: flex-start; flex-grow: 0; flex-shrink: 0; flex-direction: column; align-items: center; width: 70px;">
        <ui:Button name="WorkButton" text="&#10;" style="flex-grow: 0; flex-shrink: 0; width: 70px; height: 100px; flex-direction: column; align-items: center; color: rgb(255, 255, 255); background-color: rgb(28, 38, 51); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">

            <!-- bandeau nom -->
            <ui:VisualElement name="NameBand" style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 18px; background-color: rgb(43, 60, 79); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-width: 1px; border-bottom-color: rgb(109, 149, 187); align-items: center; justify-content: center;">
                <ui:Label text="Pawn" name="LabelName" style="width: 100%; height: 100%; color: rgb(255, 255, 255); font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 2px;"/>
            </ui:VisualElement>

            <!-- plaque image -->
            <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; width: 100%; flex-direction: column; background-color: rgb(28, 38, 51); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(67, 96, 123); border-right-color: rgb(67, 96, 123); border-bottom-color: rgb(67, 96, 123); border-left-color: rgb(67, 96, 123); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px;">
                <ui:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: space-between; padding-top: 2px; padding-right: 3px; padding-left: 3px;">
                    <ui:VisualElement style="flex-grow: 0; width: 4px; height: 4px; background-color: rgb(67, 96, 123); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;"/>
                    <ui:VisualElement style="flex-grow: 0; width: 4px; height: 4px; background-color: rgb(67, 96, 123); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Image" style="flex-grow: 1; flex-shrink: 1; padding-top: 0; padding-right: 6px; padding-bottom: 0; padding-left: 6px; margin-top: 4px;"/>
            </ui:VisualElement>

            <!-- retirer le worker -->
            <ui:Button name="ButtonRemove" text="X" style="flex-grow: 0; flex-shrink: 0; position: absolute; top: 2px; right: 2px; width: 18px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(255, 255, 255); background-color: rgb(67, 96, 123); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
        </ui:Button>

        <!-- tâche -->
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row; width: 70px; height: 16px; margin-top: 2px;">
            <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; height: 16px; background-color: rgb(43, 60, 79); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; align-items: center; justify-content: center;">
                <ui:Label text="Task" name="LabelTask" style="width: 100%; height: 100%; color: rgb(255, 255, 255); font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 2px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- avancement -->
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 70px; height: 5px; margin-top: 2px; background-color: rgb(28, 38, 51); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; overflow: hidden;">
            <ui:VisualElement name="ProgressBarFill" style="flex-grow: 0; width: 0%; height: 100%; background-color: rgb(109, 149, 187);"/>
        </ui:VisualElement>

        <!-- action -->
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row; width: 70px; height: 16px; margin-top: 2px; margin-bottom: 2px;">
            <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; height: 16px; background-color: rgb(43, 60, 79); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; align-items: center; justify-content: center;">
                <ui:Label text="Action" name="LabelAction" style="width: 100%; height: 100%; color: rgb(203, 174, 156); font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 2px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
