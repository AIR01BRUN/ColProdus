<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Barre du haut de l'écran de jeu : heure du monde à gauche, boutons de vitesse à droite. -->
    <ui:VisualElement name="ROOT" style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 34px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgb(28, 38, 51); border-bottom-width: 1px; border-bottom-color: rgb(109, 149, 187); padding-top: 0; padding-right: 8px; padding-bottom: 0; padding-left: 8px;">

        <!-- heure du monde -->
        <ui:VisualElement name="TimeContent" style="flex-grow: 0; flex-shrink: 1; flex-direction: row; align-items: center; height: 24px; background-color: rgb(43, 60, 79); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; padding-top: 0; padding-right: 10px; padding-bottom: 0; padding-left: 10px;">
            <ui:Label text="JOUR 1 - ANNEE 1" enable-rich-text="false" name="LabelDate" style="flex-grow: 0; flex-shrink: 0; width: auto; height: 100%; color: rgb(203, 174, 156); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-left; white-space: nowrap; margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 0;"/>
            <ui:Label text="00:00" enable-rich-text="false" name="LabelClock" style="flex-grow: 0; flex-shrink: 0; width: 52px; height: 100%; color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        </ui:VisualElement>

        <!-- boutons de vitesse (PAUSE, 1X, 2X, 3X) -->
        <ui:VisualElement name="SpeedContent" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: flex-end; height: 24px;"/>
    </ui:VisualElement>
</ui:UXML>
