                    <ui:VisualElement name="" style="flex-grow: 0; width: 100%; height: 100%; flex-shrink: 0; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(67, 96, 123); border-right-color: rgb(67, 96, 123); border-bottom-color: rgb(67, 96, 123); border-left-color: rgb(67, 96, 123); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; background-color: rgb(67, 96, 123); align-items: center; justify-content: center;">
