                        <ui:VisualElement name="" style="flex-grow: 0; width: 12px; height: 12px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(203, 174, 156); border-right-color: rgb(203, 174, 156); border-bottom-color: rgb(203, 174, 156); border-left-color: rgb(203, 174, 156); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; background-color: rgb(109, 149, 187);"/>
