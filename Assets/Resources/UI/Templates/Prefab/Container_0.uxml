                    <ui:VisualElement style="flex-grow: 1; min-width: 0; height: 100%; background-color: rgb(43, 60, 79); flex-direction: row;"/>
                </ui:VisualElement>
                <ui:VisualElement name="" style="flex-grow: 0; width: 40px; height: 40px; flex-shrink: 0; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-right-radius: 6px; border-bottom-right-radius: 6px; background-color: rgb(43, 60, 79);">
