<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!--
        Inventaire global du joueur, affiché sous la barre de temps, à droite.
        Deux vues : la liste complète (ListContent) et les listes déroulantes
        groupées par type puis sous-type (DropdownContent).
    -->
    <ui:VisualElement name="ROOT" style="flex-grow: 0; flex-shrink: 1; width: 100%; max-height: 420px; flex-direction: column; align-items: stretch; background-color: rgb(28, 38, 51); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); border-left-color: rgb(109, 149, 187); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; overflow: hidden;">

        <!-- en-tête : titre + résumé + boutons de vue -->
        <ui:VisualElement name="Header" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: center; padding-top: 4px; padding-right: 6px; padding-bottom: 4px; padding-left: 8px; background-color: rgb(43, 60, 79); border-bottom-width: 1px; border-bottom-color: rgb(109, 149, 187);">
            <ui:Label text="INVENTORY" enable-rich-text="false" name="Title" style="flex-grow: 1; flex-shrink: 1; height: auto; color: rgb(255, 255, 255); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-left; white-space: nowrap; margin-top: 0; margin-right: 6px; margin-bottom: 0; margin-left: 0;"/>
            <ui:Label text="" enable-rich-text="false" name="LabelInfo" style="flex-grow: 0; flex-shrink: 1; height: auto; color: rgb(203, 174, 156); font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-right; white-space: nowrap; margin-top: 0; margin-right: 6px; margin-bottom: 0; margin-left: 0;"/>
            <ui:VisualElement name="HeaderButtons" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: center;"/>
        </ui:VisualElement>

        <!-- vue 1 : tous les items possessed (nom, quantité) -->
        <ui:ScrollView name="ListContent" mode="Vertical" style="flex-grow: 1; flex-shrink: 1; padding-top: 4px; padding-right: 6px; padding-bottom: 4px; padding-left: 6px;"/>

        <!-- vue 2 : un dropdown par sous-type, groupés par type -->
        <ui:ScrollView name="DropdownContent" mode="Vertical" style="flex-grow: 1; flex-shrink: 1; padding-top: 4px; padding-right: 6px; padding-bottom: 4px; padding-left: 6px;"/>
    </ui:VisualElement>
</ui:UXML>
