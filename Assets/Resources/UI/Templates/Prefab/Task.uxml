<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ROOT" style="align-self: flex-start; flex-direction: column; flex-grow: 0; flex-shrink: 1; height: 30px; min-height: 30px;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-shrink: 0; background-color: rgb(0, 0, 0); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; width: 210px; height: auto; min-height: 30px;">
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; background-color: rgb(67, 96, 123); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-top-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); align-self: auto; justify-content: center; align-items: center; padding-left: 0; width: 100%; height: 100%; flex-direction: row;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; position: absolute; width: auto; height: 30px; margin-top: 0; padding-top: 1px; margin-bottom: 0; padding-bottom: 1px; padding-right: 1px;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 100%; width: 70px; align-items: center; justify-content: center;">
                <ui:Label text="Task :" style="margin-top: 2px; margin-right: 0; margin-bottom: 2px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: initial; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 100%; width: 70px; align-items: center; justify-content: center; border-top-left-radius: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 4px; border-left-color: rgb(109, 149, 187); border-right-color: rgb(109, 149, 187); border-top-color: rgb(109, 149, 187); border-bottom-color: rgb(109, 149, 187); margin-top: 0; margin-bottom: 0;">
                <ui:Label text="Label" name="Name" style="margin-top: 2px; margin-right: 0; margin-bottom: 2px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: initial; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="BtnContent" style="flex-grow: 1; width: 70px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
