<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="ChoiceContainer" style="flex-direction: column; min-height: 50px; background-color: rgb(20, 20, 20); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(120, 120, 120); border-right-color: rgb(120, 120, 120); border-bottom-color: rgb(120, 120, 120); border-left-color: rgb(120, 120, 120); padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
        <ui:VisualElement name="Container" style="flex-direction: column; flex-grow: 1;"/>
        <ui:VisualElement name="Buttons" style="flex-direction: row; justify-content: space-between; margin-top: 4px;">
            <ui:Button name="Validate" text="Validate" style="flex-grow: 1; margin-right: 4px;"/>
            <ui:Button name="Reset" text="Reset Selection" style="flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
